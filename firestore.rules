rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — 본인 문서만 읽고 쓸 수 있다.
    // 단, 돈과 직결된 필드(credits, paidTotal, scanTotal, freeMonth, freeRemain, dica500Granted, autocard50Granted)는
    // 서버(Worker, Admin SDK)만 바꿀 수 있다. Admin SDK는 이 규칙 자체를 건너뛰므로 Worker는 그대로 동작한다.
    // 클라이언트가 개발자도구로 이 필드들을 바꾸려는 요청은 여기서 막힌다.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['credits','paidTotal','scanTotal','freeMonth','freeRemain','dica500Granted','autocard50Granted','paidLots','creditsV2','rewardMonth','rewardCount']);
      // 내 명함 링크(비즈홈 bizhomeUrl · 오토명함 autocardUrl · 예전 dicaUrl)는 한 번 등록하면 바꾸거나 지울 수 없다 (계정당 종류별 1회)
      function keepOnce(f) { return !(f in resource.data) || (f in request.resource.data && request.resource.data[f] == resource.data[f]); }
      // 예외 1개: 무료 오토명함 → 본인이 새로 발행한 유료 오토명함으로는 바꿀 수 있다(유료로 올라가는 길). 바꾼 뒤엔 유료라 다시 못 바꾼다
      function acUrlOk(u) { return u is string && u.matches('https://jinjjabg-hub[.]github[.]io/autocard/c/[?]id=[A-Za-z0-9_-]{6,40}'); }
      function acCardOf(u) { return get(/databases/$(database)/documents/autocards/$(u.split('[?]id=')[1])).data; }
      function acFreeToPaid() {
        return 'autocardUrl' in resource.data && 'autocardUrl' in request.resource.data
          && acUrlOk(resource.data.autocardUrl) && acUrlOk(request.resource.data.autocardUrl)
          && acCardOf(resource.data.autocardUrl).get('plan', '') == 'free'
          && acCardOf(resource.data.autocardUrl).ownerUid == uid
          && acCardOf(request.resource.data.autocardUrl).get('plan', '') != 'free'
          && acCardOf(request.resource.data.autocardUrl).ownerUid == uid
          && acCardOf(request.resource.data.autocardUrl).status == 'published';
      }
      allow update: if request.auth != null && request.auth.uid == uid
        && keepOnce('bizhomeUrl') && (keepOnce('autocardUrl') || acFreeToPaid()) && keepOnce('dicaUrl')
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['credits','paidTotal','scanTotal','freeMonth','freeRemain','dica500Granted','autocard50Granted','paidLots','creditsV2','rewardMonth','rewardCount']);

      // 명함첩 — 본인 것만 읽고 쓸 수 있다.
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 개인정보 수집·이용 동의 기록 — 본인 것만 쓰고 읽는다(탈퇴 시 삭제 포함).
    // 이 규칙이 없어서 그동안 앱·명함 저장 창의 동의 기록이 모두 거부되고 있었다(오류는 화면에 안 보임).
    match /consents/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // BNI 멤버 명부 — 로그인한 사람은 누구나 읽지만(챕터 명부 조회), 등록/수정/삭제는 관리자만.
    // 앱의 isAdmin()은 클라이언트 체크라 우회 가능하므로 여기서 이메일로 다시 확인한다.
    match /bni_members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jinjjabg@gmail.com';
    }

    // 결제 기록 — Worker(Admin SDK)만 쓴다. 클라이언트는 읽기도 쓰기도 못한다(본인 결제 내역 확인 UI가 생기면 그때 read만 열어준다).
    match /payments/{orderId} {
      allow read, write: if false;
    }

    // 명함 업데이트 알림 — "내 명함이 바뀌었어요" 안내문. 뱃지 표시를 위해 로그인한 누구나 읽을 수 있다.
    // 문서 키 = 명함 주소 정규화값(index.html cbUrlKey). 그 명함을 저장한 모든 사람에게 문구가 뜨므로 쓰기는 "그 명함의 진짜 주인"만.
    //  · 새로 만들기: ownerUid가 본인, url이 내 users 문서에 등록된 내 명함 링크, 그리고 그 명함이 정말 내 것
    //      - 오토명함: autocards/{id}.ownerUid == 나
    //      - 비즈홈: Worker가 남긴 선점 기록 dicaClaims/{claimId}의 uid가 나이고 url이 같음(남의 링크를 내 것으로 등록해도 통과 못함)
    //  · 고치기·지우기: 지금 문서의 ownerUid가 본인일 때만(남이 만든 알림을 덮어쓸 수 없음), ownerUid는 바꿀 수 없음
    //  · 키 ↔ url: 오토명함과 ASCII 주소는 규칙에서 키를 다시 계산해 맞춰 본다. 한글 주소는 규칙에서 인코딩을 못 하므로
    //    읽는 쪽(getCardUpdate)이 cbUrlKey(upd.url) == 키 를 다시 확인한다.
    match /card_updates/{key} {
      function cuSigned() { return request.auth != null; }
      function cuMe() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
      function cuMine(u) { let me = cuMe(); return u == me.get('bizhomeUrl', '') || u == me.get('autocardUrl', '') || u == me.get('dicaUrl', ''); }
      function cuAcRe() { return 'https://jinjjabg-hub[.]github[.]io/(cardbook/)?autocard/c/[?]id=[A-Za-z0-9_-]{6,40}'; }
      function cuAcId(u) { return u.split('[?]id=')[1]; }
      // 오토명함: 키 = encodeURIComponent('jinjjabg-hub.github.io/autocard/c?id=' + id 소문자)
      function cuAcOk(u) {
        return key == 'jinjjabg-hub.github.io%2Fautocard%2Fc%3Fid%3D' + cuAcId(u).lower()
          && get(/databases/$(database)/documents/autocards/$(cuAcId(u))).data.ownerUid == request.auth.uid;
      }
      // 비즈홈: cbUrlKey와 같은 정규화(소문자·프로토콜/쿼리/해시/index.html/끝 슬래시 제거)
      function cuBhNorm(u) { return u.lower().replace('^https?://', '').replace('#.*$', '').replace('[?].*$', '').replace('index[.]html$', '').replace('/+$', ''); }
      function cuBhKeyOk(u) {
        let s = cuBhNorm(u);
        return !s.matches('[a-z0-9._~/%-]*') || key == s.replace('%', '%25').replace('/', '%2F');
      }
      function cuBhOk(d) {
        let c = get(/databases/$(database)/documents/dicaClaims/$(d.claimId)).data;
        return d.claimId is string && d.claimId.size() <= 400 && c.uid == request.auth.uid && c.url == d.url && cuBhKeyOk(d.url);
      }
      function cuDocOk(d) {
        return d.keys().hasOnly(['url', 'notice', 'updatedAt', 'ownerUid', 'ownerName', 'claimId'])
          && d.keys().hasAll(['url', 'notice', 'updatedAt', 'ownerUid'])
          && d.ownerUid == request.auth.uid
          && d.url is string && d.url.size() <= 300 && cuMine(d.url)
          && d.notice is string && d.notice.size() >= 1 && d.notice.size() <= 80
          && d.updatedAt is string && d.updatedAt.size() <= 40
          && d.get('ownerName', '') is string && d.get('ownerName', '').size() <= 60
          && (d.url.matches(cuAcRe()) ? cuAcOk(d.url) : cuBhOk(d));
      }
      allow read: if cuSigned();
      allow create: if cuSigned() && cuDocOk(request.resource.data);
      allow update: if cuSigned() && resource.data.ownerUid == request.auth.uid && cuDocOk(request.resource.data);
      allow delete: if cuSigned() && resource.data.ownerUid == request.auth.uid;
    }

    // 자동 명함(AutoCard) — 공개(published)된 명함은 누구나 읽고, 그 전 단계는 본인·관리자만.
    // 발행(published)은 관리자 또는 결제 확인 Worker(서비스 계정, 규칙 우회)만 → 결제하면 바로 발행.
    // 발행 후 셀프 수정: 문구·사진·연락처·디자인은 주인이 자유롭게 고치지만,
    // 가격이 걸린 항목(언어 목록·가격·상태)은 못 바꾼다. 언어 추가는 upgrade 요청 → 관리자가 결제 확인 후 반영.
    match /autocards/{cardId} {
      function acSignedIn() { return request.auth != null; }
      function acAdmin() { return acSignedIn() && request.auth.token.email == 'jinjjabg@gmail.com' && request.auth.token.email_verified == true; }
      function acOwner() { return acSignedIn() && resource.data.ownerUid == request.auth.uid; }
      // 가격 = 5,900 + (언어 수 - 1) × 5,000, 언어는 1~4개 — 클라이언트가 가격을 깎아서 보낼 수 없게 서버에서 다시 계산
      function acPriceOk(d) { return d.langs is list && d.langs.size() >= 1 && d.langs.size() <= 4 && d.price == 5900 + (d.langs.size() - 1) * 5000; }
      // 언어 추가 요청: 지금 언어를 모두 포함하고 최대 4개
      function acUpgradeOk(d) { return !('upgrade' in d) || (d.upgrade.langs is list && d.upgrade.langs.size() <= 4 && d.upgrade.langs.hasAll(resource.data.langs)); }
      // plan도 가격이 걸린 항목 — 발행 후 무료판(plan 'free')을 유료로 바꾸거나 반대로 바꾸지 못하게 잠근다
      function acLocked() { return ['ownerUid', 'ownerEmail', 'status', 'langs', 'price', 'publishedAt', 'approvedBy', 'createdAt', 'paid', 'plan']; }
      // 발행된 무료판은 사진을 계속 비워 둬야 한다(사진이 필요하면 새 유료 명함). 유료판은 사진을 자유롭게 바꾼다
      function acFreeKeep(d) { return resource.data.get('plan', '') != 'free'
        || (d.get('images', {}).get('profile', '') == '' && d.get('images', {}).get('second', '') == ''); }
      // 완전 무료판(종이명함 수준): 언어 1개·가격 0·사진 없음일 때만 결제 없이 스스로 발행할 수 있다.
      // 다국어·사진이 필요하면 새 유료 명함을 만들어야 한다(무료판에서 결제로 전환하는 업그레이드는 아직 없음).
      function acFreeOk(d) { return d.plan == 'free' && d.price == 0 && d.langs is list && d.langs.size() == 1
        && d.images.profile == '' && d.images.second == ''; }

      allow read: if resource.data.status == 'published' || acOwner() || acAdmin();
      allow create: if acSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status in ['draft', 'pending']
        && (request.resource.data.status == 'draft' || acPriceOk(request.resource.data));
      allow update: if acAdmin()
        // 발행 전(작성 중·승인 대기): 주인이 자유롭게 고치되 가격은 언어 수와 맞아야 함(무료판은 결제 없이 바로 발행)
        || (acOwner() && resource.data.status != 'published'
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.ownerEmail == resource.data.ownerEmail
            && (
              (request.resource.data.status in ['draft', 'pending'] && (request.resource.data.status == 'draft' || acPriceOk(request.resource.data)))
              || (request.resource.data.status == 'published' && acFreeOk(request.resource.data))
            ))
        // 발행 후: 셀프 수정 OK, 가격이 걸린 항목은 잠금
        || (acOwner() && resource.data.status == 'published'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(acLocked())
            && acFreeKeep(request.resource.data)
            && acUpgradeOk(request.resource.data));
      allow delete: if acAdmin() || (acOwner() && resource.data.status != 'published');
    }

    // 자동 명함 결제 기록 — Worker(서비스 계정)만 쓰고 읽음
    match /autocardPayments/{orderId} { allow read: if request.auth != null && request.auth.token.email == 'jinjjabg@gmail.com'; allow write: if false; }

    // 홈 배너 클릭 수 — 로그인한 사람은 "본인 문서"에만, 한 번에 1씩만 올릴 수 있다. 읽기는 관리자만(통계 화면).
    match /bannerClicks/{bannerId}/byUser/{uid} {
      function bcOk() { return request.auth != null && request.auth.uid == uid && bannerId in ['dica', 'bizhome', 'mandu']; }
      allow create: if bcOk() && request.resource.data.keys().hasOnly(['clicks', 'first', 'last']) && request.resource.data.clicks == 1;
      allow update: if bcOk() && request.resource.data.keys().hasOnly(['clicks', 'first', 'last'])
        && request.resource.data.clicks == resource.data.clicks + 1 && request.resource.data.first == resource.data.first;
      allow read: if request.auth != null && request.auth.token.email == 'jinjjabg@gmail.com' && request.auth.token.email_verified == true;
    }

    // 모임 공유 명함첩 — 모임장이 만들고, 초대 링크를 받은 사람이 "본인 명함"을 직접 올린다.
    //  groups/{gid}                : 모임 이름·모임장. 초대 링크(gid)를 아는 로그인 사용자는 이름을 볼 수 있다(목록 조회는 불가).
    //  groups/{gid}/members/{uid}  : 멤버가 올린 본인 명함. 같은 모임 멤버와 모임장만 읽는다.
    // 왜: BNI 명부처럼 관리자가 대신 넣어 주는 방식은 모임이 늘면 감당이 안 된다 → 멤버가 스스로 올리고, 나가면 명부에서 빠진다.
    match /groups/{gid} {
      function gSigned() { return request.auth != null; }
      function gOwner() { return gSigned() && get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid == request.auth.uid; }
      function gMember() { return gSigned() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)); }
      function gDocOk(d) { return d.keys().hasOnly(['name', 'ownerUid', 'ownerName', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40 && d.ownerUid == request.auth.uid; }
      allow get: if gSigned();
      allow list: if false;
      allow create: if gSigned() && gDocOk(request.resource.data);
      allow update: if gSigned() && resource.data.ownerUid == request.auth.uid && gDocOk(request.resource.data);
      allow delete: if gSigned() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        function mDocOk(d) { return d.keys().hasOnly(['uid', 'name', 'company', 'title', 'phone', 'email', 'industry', 'url', 'joinedAt'])
          && d.uid == uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && d.get('company', '').size() <= 60 && d.get('title', '').size() <= 60 && d.get('phone', '').size() <= 30
          && d.get('email', '').size() <= 100 && d.get('industry', '').size() <= 60 && d.get('url', '').size() <= 300; }
        allow read: if gMember() || gOwner();
        allow create, update: if gSigned() && request.auth.uid == uid && mDocOk(request.resource.data)
          && exists(/databases/$(database)/documents/groups/$(gid));
        allow delete: if gSigned() && (request.auth.uid == uid || gOwner());
      }
    }

    // 내 명함 통계(열람 수·저장한 사람 수) — Worker만 쓰고, 명함 주인만 읽는다.
    match /cardStats/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 누가 누구 명함을 저장했는지(통계용 중복 방지 기록) — Worker만 쓴다.
    match /cardSaves/{key} { allow read, write: if false; }

    // 예전 코드가 쓰다 만 최상위 컬렉션 — 지금은 아무도 안 쓰지만 혹시 남아있는 호출을 막아둔다.
    match /cards/{cardId} { allow read, write: if false; }

    // 그 외 모든 문서는 기본적으로 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
