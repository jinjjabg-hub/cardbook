rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — 본인 문서만 읽고 쓸 수 있다.
    // 단, 돈과 직결된 필드(credits, paidTotal, scanTotal, freeMonth, freeRemain, dica500Granted, autocard50Granted)는
    // 서버(Worker, Admin SDK)만 바꿀 수 있다. Admin SDK는 이 규칙 자체를 건너뛰므로 Worker는 그대로 동작한다.
    // 클라이언트가 개발자도구로 이 필드들을 바꾸려는 요청은 여기서 막힌다.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['credits','paidTotal','scanTotal','freeMonth','freeRemain','dica500Granted','autocard50Granted']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['credits','paidTotal','scanTotal','freeMonth','freeRemain','dica500Granted','autocard50Granted']);

      // 명함첩 — 본인 것만 읽고 쓸 수 있다.
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // BNI 멤버 명부 — 로그인한 사람은 누구나 읽지만(챕터 명부 조회), 등록/수정/삭제는 관리자만.
    // 앱의 isAdmin()은 클라이언트 체크라 우회 가능하므로 여기서 이메일로 다시 확인한다.
    match /bni_members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jinjjabg@gmail.com';
    }

    // 결제 기록 — Worker(Admin SDK)만 쓴다. 클라이언트는 읽기도 쓰기도 못한다(본인 결제 내역 확인 UI가 생기면 그때 read만 열어준다).
    match /payments/{orderId} {
      allow read, write: if false;
    }

    // 명함 업데이트 알림 — "내 명함이 바뀌었어요" 안내문. 뱃지 표시를 위해 로그인한 누구나 읽을 수 있고,
    // 쓰기는 본인 소유(ownerUid가 본인 uid와 일치하는 경우)만 가능 — 남의 이름으로 알림을 보낼 수 없게 막는다.
    match /card_updates/{key} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // 자동 명함(AutoCard) — 공개(published)된 명함은 누구나 읽고, 그 전 단계는 본인·관리자만.
    // 발행(published)은 관리자 또는 결제 확인 Worker(서비스 계정, 규칙 우회)만 → 결제하면 바로 발행.
    // 발행 후 셀프 수정: 문구·사진·연락처·디자인은 주인이 자유롭게 고치지만,
    // 가격이 걸린 항목(언어 목록·가격·상태)은 못 바꾼다. 언어 추가는 upgrade 요청 → 관리자가 결제 확인 후 반영.
    match /autocards/{cardId} {
      function acSignedIn() { return request.auth != null; }
      function acAdmin() { return acSignedIn() && request.auth.token.email == 'jinjjabg@gmail.com' && request.auth.token.email_verified == true; }
      function acOwner() { return acSignedIn() && resource.data.ownerUid == request.auth.uid; }
      // 가격 = 5,900 + (언어 수 - 1) × 5,000, 언어는 1~4개 — 클라이언트가 가격을 깎아서 보낼 수 없게 서버에서 다시 계산
      function acPriceOk(d) { return d.langs is list && d.langs.size() >= 1 && d.langs.size() <= 4 && d.price == 5900 + (d.langs.size() - 1) * 5000; }
      // 언어 추가 요청: 지금 언어를 모두 포함하고 최대 4개
      function acUpgradeOk(d) { return !('upgrade' in d) || (d.upgrade.langs is list && d.upgrade.langs.size() <= 4 && d.upgrade.langs.hasAll(resource.data.langs)); }
      function acLocked() { return ['ownerUid', 'ownerEmail', 'status', 'langs', 'price', 'publishedAt', 'approvedBy', 'createdAt', 'paid']; }

      allow read: if resource.data.status == 'published' || acOwner() || acAdmin();
      allow create: if acSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status in ['draft', 'pending']
        && (request.resource.data.status == 'draft' || acPriceOk(request.resource.data));
      allow update: if acAdmin()
        // 발행 전(작성 중·승인 대기): 주인이 자유롭게 고치되 가격은 언어 수와 맞아야 함
        || (acOwner() && resource.data.status != 'published'
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.ownerEmail == resource.data.ownerEmail
            && request.resource.data.status in ['draft', 'pending']
            && (request.resource.data.status == 'draft' || acPriceOk(request.resource.data)))
        // 발행 후: 셀프 수정 OK, 가격이 걸린 항목은 잠금
        || (acOwner() && resource.data.status == 'published'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(acLocked())
            && acUpgradeOk(request.resource.data));
      allow delete: if acAdmin() || (acOwner() && resource.data.status != 'published');
    }

    // 자동 명함 결제 기록 — Worker(서비스 계정)만 쓰고 읽음
    match /autocardPayments/{orderId} { allow read: if request.auth != null && request.auth.token.email == 'jinjjabg@gmail.com'; allow write: if false; }

    // 예전 코드가 쓰다 만 최상위 컬렉션 — 지금은 아무도 안 쓰지만 혹시 남아있는 호출을 막아둔다.
    match /cards/{cardId} { allow read, write: if false; }

    // 그 외 모든 문서는 기본적으로 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
