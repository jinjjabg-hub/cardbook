rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 본인 폴더만 읽고 쓸 수 있음, 명함 이미지는 2MB 이하 jpeg만
    match /users/{uid}/cards/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (request.resource == null || (request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/jpeg')));
    }

    // 자동 명함 이미지(현재 경로) — autocards/{주인 uid}/{명함 id}/파일. 폴더 이름이 곧 주인이라 Firestore를 조회하지 않음
    // (Storage 규칙에서 Firestore를 읽으려면 콘솔에서 별도 권한을 줘야 해서 업로드가 막혔음 → 조회 없이 확인)
    match /autocards/{uid}/{cardId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // (예전 경로) 자동 명함 이미지 — 누구나 볼 수 있고(공개 명함에 쓰임), 올리기는 그 명함의 주인만. 5MB 이하 이미지만.
    // 주인 확인은 Firestore autocards/{cardId}.ownerUid로 한다 → 명함 문서를 먼저 만든 뒤 업로드해야 함.
    match /autocards/{cardId}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/autocards/$(cardId)).data.ownerUid == request.auth.uid
                   && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
